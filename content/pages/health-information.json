        }
      ],
      "preset": "starter/stack-12@1"
    },
    {
      "id": "sec_vh89adz88k",
      "layout": {
        "mode": "stack",
        "columns": {
          "d": [
            12
          ]
        }
      },
      "style": {
        "colorTheme": "light"
